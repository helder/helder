<Design>
	<Frame name="Home" cover width={390} height={844} canvas:at="0 0" background="#f8fafc" padding="56 24 24" rowGap={16}>
		<note>The list as it opens: three items, one done.</note>
		<text tag="title" fontSize={28} fontWeight={700} color="#3b82f6">todos</text>
		<view flexDirection="row" columnGap={8} alignItems="center" padding="10 12" background="#ffffff" borderRadius={10} borderWidth={1} borderColor="#e2e8f0">
			<text flexGrow={1} color="#94a3b8">What needs to be done?</text>
			<view padding="6 12" background="#3b82f6" borderRadius={8}>
				<text color="#ffffff" fontWeight={600}>Add</text>
			</view>
		</view>
		<view rowGap={1} background="#e2e8f0" borderRadius={10} overflow="hidden">
			<view flexDirection="row" columnGap={12} alignItems="center" padding="12 14" background="#ffffff">
				<view width={18} height={18} borderRadius={9} background="#22c55e"/>
				<text flexGrow={1} color="#94a3b8">Sketch the home screen</text>
			</view>
			<view flexDirection="row" columnGap={12} alignItems="center" padding="12 14" background="#ffffff">
				<view width={18} height={18} borderRadius={9} borderWidth={2} borderColor="#cbd5e1"/>
				<text flexGrow={1}>Pick the colours</text>
			</view>
			<view flexDirection="row" columnGap={12} alignItems="center" padding="12 14" background="#ffffff">
				<view width={18} height={18} borderRadius={9} borderWidth={2} borderColor="#cbd5e1"/>
				<text flexGrow={1}>Write the list in code</text>
			</view>
		</view>
		<text fontSize={13} color="#64748b">2 items left</text>
	</Frame>
	<Frame name="Empty" width={390} height={844} canvas:at="430 0" background="#f8fafc" padding="56 24 24" rowGap={16} alignItems="center">
		<text fontSize={28} fontWeight={700} color="#3b82f6" alignSelf="start">todos</text>
		<view flexGrow={1} justifyContent="center" alignItems="center" rowGap={8}>
			<image src="empty.svg" width={64} height={64}/>
			<text fontSize={17} fontWeight={600}>Nothing to do</text>
			<text color="#64748b">Add an item to get started.</text>
		</view>
	</Frame>
</Design>
