<Design>
	<Frame name="Home" width={390} height={844} canvas:at="0 0" background="#ffffff" padding="64 24 24" rowGap={12}>
		<note>A design file: drawn at once, nothing built. Select, move, resize; the inspector edits it.</note>
		<text tag="title" fontSize={32} fontWeight={700} color="#111827">Hello</text>
		<text color="#6b7280">A first screen. Edit the text, the colours, the spacing.</text>
		<view flexDirection="row" columnGap={8} padding="16 0 0">
			<view padding="10 16" background="#111827" borderRadius={10}>
				<text color="#ffffff" fontWeight={600}>Start</text>
			</view>
			<view padding="10 16" borderRadius={10} borderWidth={1} borderColor="#d1d5db">
				<text color="#111827">Later</text>
			</view>
		</view>
	</Frame>
	<Frame name="Next" width={390} height={844} canvas:at="430 0" background="#f9fafb" padding="64 24 24" rowGap={16}>
		<text fontSize={24} fontWeight={700} color="#111827">Next</text>
		<view padding="16" background="#ffffff" borderRadius={12} borderWidth={1} borderColor="#e5e7eb" rowGap={4}>
			<text fontWeight={600}>A card</text>
			<text color="#6b7280">Frames are screens. Add one beside this.</text>
		</view>
	</Frame>
</Design>
