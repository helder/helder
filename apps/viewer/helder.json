{
  "$schema": "https://helder.build/schema/helder.json",
  "name": "Viewer",
  "description": "A file browser and image viewer: browse a folder of photos, PDFs and videos, and open any of them full size.",
  "id": "org.helder.viewer",
  "version": "0.2.0",
  "build": 2,
  "icon": "icon.png",
  "colors": {
    "theme": "#161618",
    "background": "#161618"
  },
  "fileHandlers": [
    {
      "action": "/open",
      "accept": {
        "image/jpeg": [".jpg", ".jpeg", ".jfif"],
        "image/png": [".png", ".apng"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "application/pdf": [".pdf"],
        "image/tiff": [".tif", ".tiff"],
        "image/heic": [".heic", ".heif"],
        "image/avif": [".avif"]
      }
    }
  ],
  "run": {
    "name": "viewer",
    "listed": true,
    "kind": "app",
    "tags": ["photos", "files", "pdf"],
    "source": "https://github.com/helder/helder/tree/main/apps/viewer"
  }
}
