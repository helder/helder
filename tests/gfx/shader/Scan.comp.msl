#include <metal_stdlib>
using namespace metal;
struct ComputeInput {
	int x;
	int y;
	int z;
	int localX;
	int localY;
	int localZ;
	int localIndex;
	int groupX;
	int groupY;
	int groupZ;
};
struct ScanStep {
	int offset;
	int count;
};
void cs(ComputeInput id, ScanStep step_2, const device int* sb_1, device atomic_int* sb_2) {
	int i = id.x;
	if (i >= step_2.count) {
		return;
	}
	int v = sb_1[i];
	if (i >= step_2.offset) {
		v += sb_1[i - step_2.offset];
	}
	atomic_store_explicit(&sb_2[i], v, memory_order_relaxed);
}
struct ScanStep_buffer {
	int offset;
	int count;
};
kernel void main0(uint3 gid [[thread_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]], uint lidx [[thread_index_in_threadgroup]], uint3 grp [[threadgroup_position_in_grid]], constant ScanStep_buffer& u_0 [[buffer(0)]], const device int* sb_1 [[buffer(1)]], device atomic_int* sb_2 [[buffer(2)]]) {
	cs(ComputeInput{int(gid.x), int(gid.y), int(gid.z), int(lid.x), int(lid.y), int(lid.z), int(lidx), int(grp.x), int(grp.y), int(grp.z)}, ScanStep{u_0.offset, u_0.count}, sb_1, sb_2);
}
