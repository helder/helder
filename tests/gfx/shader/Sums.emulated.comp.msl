#include <metal_stdlib>
using namespace metal;
struct ComputeInput {
	int x;
	int y;
	int z;
	int localX;
	int localY;
	int localZ;
	int localIndex;
	int groupX;
	int groupY;
	int groupZ;
	int subgroupLane;
	int subgroupSize;
	int subgroupIndex;
	int subgroups;
};
struct Count {
	int n;
};
void cs(ComputeInput id, Count count, const device float* sb_1, device float* sb_2, threadgroup float* wg_0, threadgroup float* wg_1) {
	float v = (id.x < count.n) ? sb_1[id.x] : 0.0;
	wg_1[id.localIndex] = v;
	threadgroup_barrier(mem_flags::mem_threadgroup);
	float sg_0 = ((wg_1[id.localIndex & (-4)] + wg_1[(id.localIndex & (-4)) + 1]) + wg_1[(id.localIndex & (-4)) + 2]) + wg_1[(id.localIndex & (-4)) + 3];
	threadgroup_barrier(mem_flags::mem_threadgroup);
	v = sg_0;
	if (id.subgroupLane == 0) {
		int t0 = id.subgroupIndex;
		wg_0[t0] = v;
	}
	threadgroup_barrier(mem_flags::mem_threadgroup);
	if (id.localIndex == 0) {
		float s = 0.0;
		int t = 0;
		int t_2 = id.subgroups;
		while (t < t_2) {
			int k = t;
			t += 1;
			s += wg_0[k];
		}
		int t1 = id.groupX;
		sb_2[t1] = s;
	}
}
struct Count_buffer {
	int n;
};
kernel void main0(uint3 gid [[thread_position_in_grid]], uint3 lid [[thread_position_in_threadgroup]], uint lidx [[thread_index_in_threadgroup]], uint3 grp [[threadgroup_position_in_grid]], constant Count_buffer& u_0 [[buffer(0)]], const device float* sb_1 [[buffer(1)]], device float* sb_2 [[buffer(2)]]) {
	threadgroup float wg_0[256];
	threadgroup float wg_1[256];
	cs(ComputeInput{int(gid.x), int(gid.y), int(gid.z), int(lid.x), int(lid.y), int(lid.z), int(lidx), int(grp.x), int(grp.y), int(grp.z), int(lidx) & 3, 4, int(lidx) >> 2, 64}, Count{u_0.n}, sb_1, sb_2, wg_0, wg_1);
}
