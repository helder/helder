|     <meta {http://www.w3.org/1999/xhtml}>
|       content="ahem"
|       name="flags"
|     "

  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="/fonts/ahem.css"
|       rel="stylesheet"
|       type="text/css"
|     "
  "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
   /* setup */
   td * { white-space: normal; font: inherit; }
   div { display: block; }
   span { display: inline; }

   /* test */
   td { font: 20px/1 Ahem; color: maroon; background: red; padding: 0; }
   span { background: lime; }
   div { color: green; }
