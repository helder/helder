        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            html
            {
                background: url('support/margin-collapse-020.png') 0 -1em no-repeat;
                font: 20px/1em Ahem;
                margin-top: 1em;
            }
            body
            {
                margin: 0;
            }
            div
            {
                background: green;
                margin-top: 1em;
                height: 1em;
                width: 5em;
            }
            p
            {
                font: 12pt serif;
            }
