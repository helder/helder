  "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       <![CDATA[
  body {color: navy;}

  div
  {
  display: list-item;
  margin-left: 2.5em;
  }

  div.circ {list-style-type: circle;}

  div.squa {list-style-type: square;}

  div#first {margin-top: 1em;}
  ]]>
