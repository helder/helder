|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Top using pixels with a value of zero, 0px"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
		"
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.gtalbot.org/BrowserBugsSection/css21testsuite/"
|       rel="reviewer"
|       title="Gérard Talbot"
|     " "
|     <!--  2012-09-14  -->
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visuren.html#propdef-top"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visuren.html#position-props"
|       rel="help"
|     "
		"
|     <link {http://www.w3.org/1999/xhtml}>
|       href="../reference/ref-no-vert-space-between.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'top' property sets a zero length value in pixels."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                position: relative;
            }
            #div1
            {
                border-top: blue solid 5px;
            }
            #div2
            {
                border-top: orange solid 5px;
                top: 0px;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there is "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "no space between"
|       " the blue and orange lines."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="div1"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div2"
|       "
        "
