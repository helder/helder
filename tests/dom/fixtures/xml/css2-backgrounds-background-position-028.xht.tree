|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="image"
|       name="flags"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'background-position' property correctly applies a negative zero length value in picas."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                background-repeat: no-repeat;
                height: 3in;
                width: 3in;
            }
            #div1
            {
                background-image: url("support/background-position-center-left.png");
            }
            div div
            {
                background-image: url("support/blue96x96.png");
                background-position: -0pc;
            }
        "
