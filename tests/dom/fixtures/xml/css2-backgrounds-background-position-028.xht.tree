        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Background-position using picas with a negative zero value, -0pc"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
