| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Margin-right using inches with a nominal value with a plus sign, +1in"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
		"
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.gtalbot.org/BrowserBugsSection/css21testsuite/"
|       rel="reviewer"
|       title="Gérard Talbot"
|     " "
|     <!--  2012-08-18  -->
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/box.html#propdef-margin-right"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/box.html#margin-properties"
|       rel="help"
|     "
		"
|     <link {http://www.w3.org/1999/xhtml}>
|       href="margin-left-067-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'margin-right' property sets a nominal length value in inches with a plus sign."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                direction: rtl;
                height: 1in;
                width: 0;
            }
            #wrapper
            {
                border-right: 0.25in solid red;
            }
            #div1
            {
                margin-right: +1in;
            }
            #div2
            {
                border-right: 0.25in solid black;
                margin-right: -1.25in;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there is "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "no red"
|       "."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="wrapper"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div1"
|         "
                "
|         <div {http://www.w3.org/1999/xhtml}>
|           id="div2"
|         "
            "
|       "
        "
|     "
    "
|   "
"
