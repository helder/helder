|       class="six"
|       "
   This sentence should be green.
  "
|     "
  "
|     <p {http://www.w3.org/1999/xhtml}>
|       class="seven"
|       "
   This sentence should be green.
  "
|     "
  "
|     <p {http://www.w3.org/1999/xhtml}>
|       class="eight"
|       "
   This sentence should be green.
