        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Min-width using pixels with a nominal value, 96px"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
  	    "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.gtalbot.org/BrowserBugsSection/css21testsuite/"
|       rel="reviewer"
|       title="Gérard Talbot"
|     " "
|     <!--  2012-11-02  -->
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visudet.html#propdef-min-width"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visudet.html#min-max-widths"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="max-width-006-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'min-width' property sets a nominal length value in pixels."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            #div1
            {
                background: black;
                height: 1in;
                min-width: 96px;
                width: 0;
            }
            #div2
            {
                border-left: 96px solid black;
                height: 1in;
                margin-top: 4px;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if 2 black squares have the "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "same width"
|       "."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="div1"
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="div2"
|     "
