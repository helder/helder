| <!DOCTYPE html "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
 "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
  "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Paged Media root container (float)"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="mailto:melinda.grant@hp.com"
|       rel="author"
|       title="Melinda Grant"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/page.html#page-box"
|       rel="help"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visudet.html#the-height-property"
|       rel="help"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/css3-page/#page-box-page-rule"
|       rel="help"
|     "
  "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="paged may"
|       name="flags"
|     "
  "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The root element when floated abuts the left or right edge of the page area."
|       name="assert"
|     "
  "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
    html {
			width: 50%;
			float: right;
			border: medium solid purple;
}
    div {
			page-break-before: always;
}
  "
|     "
 "
|   "
 "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
  "
|     <p {http://www.w3.org/1999/xhtml}>
|       "This test produces two pages of output."
|     "
  "
|     <p {http://www.w3.org/1999/xhtml}>
|       "The text on this page has a left, top, and right purple border which should be entirely on the right
	half of the page.  (There should be no bottom border.)"
|     "
	"
|     <div {http://www.w3.org/1999/xhtml}>
|       "The text on this page has a left, bottom, and right purple border which should be entirely on the right
	half of the page.  (There should be no top border.)"
|     "
 "
