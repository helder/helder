"
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
body { margin:0; }
.pos { position:absolute; width:100px; height:100px; }
"
|     "
"
|   "
"
|   <body {http://www.w3.org/1999/xhtml}>
|     "
"
|     <div {http://www.w3.org/1999/xhtml}>
|       style="height:10000px; margin:0; margin:10px; border:20px solid black; padding:30px;"
|     "
"
|     <script {http://www.w3.org/1999/xhtml}>
|       type="text/javascript"
|       "
window.scrollTo(0,50);
"
|     "
"
|     <div {http://www.w3.org/1999/xhtml}>
|       class="pos"
|       style="top:0; left:60px; background:yellow;"
|     "
"
|     <div {http://www.w3.org/1999/xhtml}>
|       class="pos"
|       style="right:0; top:60px; background:orange;"
|     "
"
|     <div {http://www.w3.org/1999/xhtml}>
|       class="pos"
|       style="bottom:0; left:60px; background:brown;"
|     "
"
|     <div {http://www.w3.org/1999/xhtml}>
|       class="pos"
|       style="left:0; top:60px; background:pink;"
