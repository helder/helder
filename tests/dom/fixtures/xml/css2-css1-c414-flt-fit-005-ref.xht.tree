  "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       <![CDATA[
  div.control {padding: 1em;}

  div.control > div
  {
  background: navy;
  color: yellow;
  width: 10em;
  }

  div.control > div.right
  {
  margin-left: 5em;
  text-align: right;
  }
  ]]>
