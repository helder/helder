| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Bottom using percentages with a positive nominal value, +100%"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
		"
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.gtalbot.org/BrowserBugsSection/css21testsuite/"
|       rel="reviewer"
|       title="Gérard Talbot"
|     " "
|     <!--  2012-09-14  -->
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visuren.html#propdef-bottom"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visuren.html#position-props"
|       rel="help"
|     "
		"
|     <link {http://www.w3.org/1999/xhtml}>
|       href="bottom-019-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'bottom' property sets a positive nominal length value in percentages."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                position: relative;
            }
            #div1
            {
                border-top: 1in solid red;
                height: 1in;
            }
            #div2
            {
                border-top: 1in solid black;
                bottom: +100%;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there is "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "no red"
|       "."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="div1"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div2"
|       "
        "
|     "
    "
|   "
"
