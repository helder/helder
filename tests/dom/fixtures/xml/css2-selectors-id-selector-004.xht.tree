        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Invalid ID selector syntax - white space between # and id"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/selector.html#id-selectors"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="../reference/no-red-filler-text-ref.xht"
|       rel="match"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="invalid"
|       name="flags"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="White space is not allowed between # and identifier for selector."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            # div1
            {
                color: red;
            }
        "
