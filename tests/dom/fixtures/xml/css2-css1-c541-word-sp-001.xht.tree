|     "
  "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       <![CDATA[
   div { font: 25px/1 Ahem; width: 12em; background: yellow; color: aqua; margin: 0 0 0 2em; }
   .eight {word-spacing: 25px;}
   .nine {word-spacing: normal;}
   .ten {word-spacing: -1em;}
   .fill { color: yellow; }
  ]]>
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/text.html#spacing-props"
|       rel="help"
|       title="16.4 Letter and word spacing: the 'letter-spacing' and 'word-spacing' properties"
|     "
