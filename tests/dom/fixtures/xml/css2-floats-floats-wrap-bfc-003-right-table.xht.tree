|       rel="match"
|     "
	"
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The border box of a table, a block-level replaced element, or an element in the normal flow that establishes a new block formatting context (such as an element with 'overflow' other than 'visible') must not overlap any floats in the same block formatting context as the element itself."
|       name="assert"
|     "
	"
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="text/html; charset=UTF-8"
|       http-equiv="Content-Type"
|     "
	"
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="text/css"
|       http-equiv="Content-Style-Type"
|     "
	"
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "

	table { margin: 0; border-spacing: 0; }
	td, th { padding: 0; }

	span { display: inline-block; vertical-align: bottom; }

	"
