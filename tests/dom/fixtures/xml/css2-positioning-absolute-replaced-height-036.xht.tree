| <!DOCTYPE html "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
 "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
  "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Absolute Replaced Elements: specified 'top' and 'bottom' with auto margins"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://fantasai.inkedblade.net/"
|       rel="author"
|       title="Elika J. Etemad"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visufx.html#clipping"
|       rel="help"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="../reference/ref-if-there-is-no-red.xht"
|       rel="match"
|     "

  "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="image"
|       name="flags"
|     "
  "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="If 'top' and 'bottom' are specified on an     absolutely-positioned replaced element, then any remaining space is     split amongst the 'auto' vertical margins."
|       name="assert"
|     "
  "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
    .container {
      position: relative;
      width: 45px;
      height: 45px;
      /* Uncomment for debugging:
         border: solid silver;
         background: aqua; */
    }
    .abspos {
      position: absolute;
      top: 0; bottom: 0;
      background: red;
    }
    .one {
      margin: auto;
      left: 0;
    }
    .two {
      margin-top: auto;
      left: 15px;
    }
    .three {
      margin-bottom: auto;
      right: 0;
    }
    .control1 {
      height: 15px;
      border-right: 15px solid red;
    }
    .control2 {
      height: 15px;
      border-left: 15px solid red;
    }
    .control3 {
      height: 15px;
      margin: 0 15px;
      background: red;
    }
  "
|     "
 "
|   "
 "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
    "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there is "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "no red"
|       "."
|     "
    "
|     <div {http://www.w3.org/1999/xhtml}>
|       class="container"
|       "
      "
|       <img {http://www.w3.org/1999/xhtml}>
|         alt="FAIL: image support required"
|         class="abspos one"
|         src="support/swatch-white.png"
|       "
      "
|       <img {http://www.w3.org/1999/xhtml}>
|         alt="FAIL: image support required"
|         class="abspos two"
|         src="support/swatch-white.png"
|       "
      "
|       <img {http://www.w3.org/1999/xhtml}>
|         alt="FAIL: image support required"
|         class="abspos three"
|         src="support/swatch-white.png"
|       "
      "
|       <div {http://www.w3.org/1999/xhtml}>
|         class="control1"
|       "
      "
|       <div {http://www.w3.org/1999/xhtml}>
|         class="control2"
|       "
      "
|       <div {http://www.w3.org/1999/xhtml}>
|         class="control3"
|       "
    "
|     "
 "
|   "
"
