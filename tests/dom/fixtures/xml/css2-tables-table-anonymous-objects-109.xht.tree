|     <script {http://www.w3.org/1999/xhtml}>
|       type="text/javascript"
|       <![CDATA[
      function doTest() {
        var t = document.getElementById("t");
        t.parentNode.removeChild(t);
        document.documentElement.className = "";
      }
    ]]>
