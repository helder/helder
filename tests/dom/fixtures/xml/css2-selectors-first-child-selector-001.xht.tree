|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: First-child pseudo-class"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/selector.html#first-child"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="first-child-selector-001-ref.html"
|       rel="match"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="First-child pseudo-class matches only the first element of its type."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div:first-child
            {
                color: green;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       "Filler Text"
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       "Filler Text"
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if the first "Filler Text" above is green and the second one is black."
