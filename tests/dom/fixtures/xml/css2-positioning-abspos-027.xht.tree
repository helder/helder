  "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
  body {margin-top: 1em; }

   .test { position: absolute; background: red; }
   table { background: white; color: black; margin: auto; border-spacing: 0px; }
   td { padding: 0px; }
  "
|     "
 "
|   "
 "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
  "
|     <div {http://www.w3.org/1999/xhtml}>
|       class="test"
|       "
   "
|       <table {http://www.w3.org/1999/xhtml}>
|         "
    "
|         <tr {http://www.w3.org/1999/xhtml}>
|           "
     "
|           <td {http://www.w3.org/1999/xhtml}>
|             "Test passes if there is "
|             <strong {http://www.w3.org/1999/xhtml}>
|               "no red"
|             "."
