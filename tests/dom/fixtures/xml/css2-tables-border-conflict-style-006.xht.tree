| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Border Conflict Resolution (by border style): 'dashed' vs. 'inset' - border with highest priority border style should dominate"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/tables.html#border-conflict-resolution"
|       rel="help"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'dashed' border is the dominant border when it is collapsed with a 'inset' border of the same size."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            #table1
            {
                margin-bottom: 20px;
            }
            table
            {
                border-collapse: collapse;
            }
            td
            {
                border: 5px dashed lime;
                height: 3em;
                width: 3em;
            }
            #center
            {
                border: 5px inset red;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if the center box in the table below has a border similar to this:"
|     "
        "
|     <table {http://www.w3.org/1999/xhtml}>
|       id="table1"
|       "
            "
|       <tr {http://www.w3.org/1999/xhtml}>
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|         "
            "
|       "
        "
|     "
        "
|     <table {http://www.w3.org/1999/xhtml}>
|       "
            "
|       <tr {http://www.w3.org/1999/xhtml}>
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           "dashed"
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           "dashed"
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           "dashed"
|         "
            "
|       "
            "
|       <tr {http://www.w3.org/1999/xhtml}>
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           "dashed"
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           id="center"
|           "inset"
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           "dashed"
|         "
            "
|       "
            "
|       <tr {http://www.w3.org/1999/xhtml}>
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           "dashed"
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           "dashed"
|         "
                "
|         <td {http://www.w3.org/1999/xhtml}>
|           "dashed"
|         "
            "
|       "
        "
|     "
    "
|   "
"
