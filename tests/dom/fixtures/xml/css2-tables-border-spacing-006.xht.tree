|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Border-spacing using pixels with a nominal value, 96px"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/tables.html#propdef-border-spacing"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/tables.html#separated-borders"
|       rel="help"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="ahem"
|       name="flags"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="Border-spacing can be set to nominal length in pixels."
|       name="assert"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="/fonts/ahem.css"
|       rel="stylesheet"
|       type="text/css"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div, table
            {
                font: 20px/1 Ahem;
            }
            div
            {
                background: black;
                height: 1em;
                left: 216px;
                position: relative;
                top: 96px;
                width: 96px;
            }
            table
            {
                border-spacing: 96px;
            }
            td
            {
                padding: 0;
            }
        "
|     "
    "
