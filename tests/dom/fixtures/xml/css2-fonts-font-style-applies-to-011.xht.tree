| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Font-style and 'display: table-row' elements"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/fonts.html#propdef-font-style"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/fonts.html#font-styling"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/css-fonts-3/#font-style-prop"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="../../reference/pass_if_filler_text_slanted.xht"
|       rel="match"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'font-style' property applies to 'display: table-row' elements."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            #table
            {
                display: table;
            }
            #row
            {
                display: table-row;
                font-style: italic;
            }
            #cell
            {
                display: table-cell;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if the "Filler Text" below is slanted to one side."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="table"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="row"
|         "
                "
|         <div {http://www.w3.org/1999/xhtml}>
|           id="cell"
|           "Filler Text"
|         "
            "
|       "
        "
|     "
    "
|   "
