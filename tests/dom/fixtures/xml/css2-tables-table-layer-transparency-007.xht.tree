| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Background on a row element shows if all elements above its layer are transparent"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/tables.html#table-layers"
|       rel="help"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="A background set on a row element will show if all table element layers above it are transparent."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            table
            {
                border-collapse: collapse;
            }
            table, colgroup, col, tbody
            {
                background-color: red;
            }
            tr
            {
                background-color: green;
            }
            td
            {
                height: 2em;
                width: 2em;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there is no red visible on the page."
|     "
        "
|     <table {http://www.w3.org/1999/xhtml}>
|       "
            "
|       <colgroup {http://www.w3.org/1999/xhtml}>
|         "
                "
|         <col {http://www.w3.org/1999/xhtml}>
|         "
                "
|         <col {http://www.w3.org/1999/xhtml}>
|         "
                "
|         <col {http://www.w3.org/1999/xhtml}>
|         "
            "
|       "
            "
|       <tbody {http://www.w3.org/1999/xhtml}>
|         "
                "
|         <tr {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
|           "
                "
|         "
                "
|         <tr {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
|           "
                "
|         "
                "
|         <tr {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
|           "
                    "
|           <td {http://www.w3.org/1999/xhtml}>
