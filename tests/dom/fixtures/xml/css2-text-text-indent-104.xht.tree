| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Text-indent set to '+50%'"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/text.html#propdef-text-indent"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/text.html#indentation-prop"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="https://drafts.csswg.org/css-text-3/#text-indent-property"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="text-indent-103-ref.xht"
|       rel="match"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="ahem"
|       name="flags"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="Ensure that text-indent +50% adds 50% of its containing block's width in front of the text."
|       name="assert"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="/fonts/ahem.css"
|       rel="stylesheet"
|       type="text/css"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            #parent
            {
                font: 16px/1em Ahem;
                position: relative;
                width: 400px;
            }
            #reference
            {
                color: red;
                left: 0;
                position: absolute;
                top: 0;
                z-index: -1;
            }
            #test
            {
                text-indent: +50%;
                margin-left: -50%;
                margin-right: 50%;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there is no red visible on the page."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="parent"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="reference"
|         "X"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="test"
|         "X"
|       "
        "
|     "
    "
|   "
"
