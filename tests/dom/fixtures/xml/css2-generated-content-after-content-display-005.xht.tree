| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "

 "
|   <head {http://www.w3.org/1999/xhtml}>
|     "

  "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: :after generated content - display inline-block"
|     "

  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.gtalbot.org/BrowserBugsSection/css21testsuite/"
|       rel="author"
|       title="Gérard Talbot"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/generate.html#before-after-content"
|       rel="help"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visuren.html#display-prop"
|       rel="help"
|     "
  "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="after-content-display-001-ref.xht"
|       rel="match"
|     "
  "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="Generated content can have their own display value explicitly set in which case they behave as if they were real elements inserted just inside their associated element."
|       name="assert"
|     "

  "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       <![CDATA[
  div:after
  {
  content: "Filler text";
  display: inline-block;
  }
  ]]>
|     "

 "
|   "

 "
|   <body {http://www.w3.org/1999/xhtml}>
|     "

  "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if the 2 "Filler text" are both "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "on the same line"
|       "."
|     "

  "
|     <div {http://www.w3.org/1999/xhtml}>
|       "Filler text "
|     "

