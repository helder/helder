| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Border-top-width using millimeters with a nominal value with a plus sign, +25.4mm"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.gtalbot.org/BrowserBugsSection/css21testsuite/"
|       rel="reviewer"
|       title="Gérard Talbot"
|     " "
|     <!--  2012-06-24  -->
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/box.html#propdef-border-top-width"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/box.html#border-width-properties"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="border-bottom-width-006-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'border-top-width' property supports a nominal length value in millimeters that has a plus sign before it."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                display: inline-block;
                width: 1in;
            }
            #reference
            {
                background-color: black;
                height: 1in;
                margin-left: 5px;
            }
            #test
            {
                border-top-style: solid;
                border-top-width: +25.4mm;
                height: 0;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if the 2 filled black squares have the "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "same height"
|       "."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="test"
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="reference"
|     "
    "
|   "
