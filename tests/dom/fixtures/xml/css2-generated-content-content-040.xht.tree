| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Content with a 'attr()' function as a value selecting 'accesskey'"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/generate.html#propdef-content"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/generate.html#content"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="content-040-ref.html"
|       rel="match"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'content' property correctly handles the 'attr()' function when calling the attribute 'accesskey'."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            a:before
            {
                content: attr(accesskey);
                color: green;
            }
            div
            {
                border: 2px solid black;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if the letter "P" appears in the box below."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       "
            "
|       <a {http://www.w3.org/1999/xhtml}>
|         accesskey="P"
|       "
        "
|     "
    "
|   "
