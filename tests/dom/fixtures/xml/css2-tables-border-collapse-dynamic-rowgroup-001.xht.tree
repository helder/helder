"
|     <script {http://www.w3.org/1999/xhtml}>
|       type="text/javascript"
|       "
function doTest(){
 var t1 =document.getElementById('target');
 t1.style.borderColor="yellow";
}
"
|     "
"
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       <![CDATA[
td { border: 10px green solid;}
table {margin: 30px; border-collapse:collapse}
tbody#target {border:solid green 11px}
]]>
|     "
"
|   "
"
|   <body {http://www.w3.org/1999/xhtml}>
|     onload="doTest();"
|     "

"
|     <p {http://www.w3.org/1999/xhtml}>
|       "There should be a continuous solid yellow border around the middle row. All other borders should be a continuous solid green."
