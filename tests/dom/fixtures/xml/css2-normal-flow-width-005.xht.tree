|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'width' property sets a positive zero length value in pixels."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                background: red;
                height: 1in;
                width: +0px;
            }
