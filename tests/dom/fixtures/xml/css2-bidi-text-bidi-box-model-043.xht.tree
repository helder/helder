|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       <![CDATA[
      div {
      width: 20em;
      text-align: right;
      padding-right: 5em;
      margin-bottom: 1em;
      background: navy;
      font: 1.25em/1 Ahem;
      color: orange;
      }

      .rtol {
      direction: rtl;
      unicode-bidi: bidi-override;
      }

    ]]>
