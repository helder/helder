        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'font' property applies to 'display: inline-table' elements."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            #reference, #table
            {
                font: italic small-caps bold 16px sans-serif;
            }
            #table
            {
                display: inline-table;
            }
            .row
            {
                display: table-row;
            }
            .cell
            {
                display: table-cell;
            }
        "
