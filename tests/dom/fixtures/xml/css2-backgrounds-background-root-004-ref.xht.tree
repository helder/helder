|       <![CDATA[
  body
  {
  background-color: navy;
  border: blue solid;
  color: white;
  margin: 1em;
  padding: 2em;
  }

  div
  {
  background-color: green;
  border: lime solid;
  padding: 3em;
  }
  ]]>
