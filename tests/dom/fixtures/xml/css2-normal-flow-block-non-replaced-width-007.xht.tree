|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Box centering with 'margin-left' and 'margin-right' set to auto"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.gtalbot.org/BrowserBugsSection/css21testsuite/"
|       rel="reviewer"
|       title="Gérard Talbot"
|     " "
|     <!--  2012-09-29  -->
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visudet.html#blockwidth"
|       rel="help"
|     "
		"
|     <link {http://www.w3.org/1999/xhtml}>
|       href="block-non-replaced-width-007-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="ahem"
|       name="flags"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="When 'margin-left' and 'margin-right' are set to 'auto' and the element has a 'width', then the box will be centered within the edges of its containing block."
|       name="assert"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="/fonts/ahem.css"
|       rel="stylesheet"
|       type="text/css"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            #div1
            {
                border: solid black;
                height: 200px;
                width: 200px;
            }
            #div2
            {
                background-color: orange;
                border-color: orange;
                border-style: solid;
                border-width: 0 25px;
                margin: 0 auto;
                padding: 0;
                height: 100px;
                width: 50px;
            }
            #div3
            {
                color: blue;
                font: 100px/1 Ahem;
                text-align: center;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if the blue and orange squares have the same width and the blue square is directly below the orange square."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="div1"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div2"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div3"
|         "X"
|       "
