        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="border-applies-to-001-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'border' property applies to elements with a display of 'inline-table'."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            #table
            {
                border: green solid 4px;
                display: inline-table;
                table-layout: fixed;
                width: 96px;
            }
            .row
            {
                display: table-row;
            }
            .cell
            {
                color: white;
                display: table-cell;
                height: 48px;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there is a hollow green square."
|     "

        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="table"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         class="row"
|         "
                "
|         <div {http://www.w3.org/1999/xhtml}>
|           class="cell"
|           "a"
|         <div {http://www.w3.org/1999/xhtml}>
|           class="cell"
|           "b"
|         "
            "
|       "

            "
