        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Border applied to element with 'display' set to 'inline-table'"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
