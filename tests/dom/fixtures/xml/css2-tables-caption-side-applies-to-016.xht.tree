|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/tables.html#propdef-caption-side"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/tables.html#caption-position"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
