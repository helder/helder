|       rel="match"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="Caption-side does not apply to 'display: none' elements."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                background: red;
                caption-side: bottom;
                display: none;
            }
