|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       <![CDATA[
      .r { direction: rtl; }
      .l { direction: ltr; }
      div.r { width: 20em; }
      span { border: 2px solid; padding: 0 10px 0 5px; margin: 0 60px 0 30px; }
  ]]>
