|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       <![CDATA[
  div
  {
  border: black solid 5px;
  height: 2in;
  text-align: right;
  width: 2in;
  }

  img {vertical-align: top;}
  ]]>
