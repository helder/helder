| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Line-height using 'ex' units with a minimum value, 0ex"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visudet.html#propdef-line-height"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visudet.html#leading"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="line-height-002-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="ahem"
|       name="flags"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'line-height' property sets a minimum length value in 'ex' units."
|       name="assert"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="/fonts/ahem.css"
|       rel="stylesheet"
|       type="text/css"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                font: 20px/1 Ahem;
                position: relative;
                width: 1em;
            }
            #div2, #div3
            {
                background: black;
            }
            #div2
            {
                line-height: 0ex;
            }
            #div3
            {
                height: 1em;
                left: 1.1em;
                position: absolute;
                top: -0.5em;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if the 2 small black squares have the "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "same height"
|       "."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="div1"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div2"
|         "X X"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div3"
|       "
        "
|     "
    "
|   "
"
