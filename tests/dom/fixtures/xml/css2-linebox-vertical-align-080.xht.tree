| <!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
| <html {http://www.w3.org/1999/xhtml}>
|   xmlns {http://www.w3.org/2000/xmlns/}="http://www.w3.org/1999/xhtml"
|   "
    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Vertical-align using 'em' units with a positive nominal value, +6em"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visudet.html#propdef-vertical-align"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/visudet.html#leading"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="vertical-align-079-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="ahem"
|       name="flags"
|     "
        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'vertical-align' property sets a positive nominal length value in 'em' units."
|       name="assert"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="/fonts/ahem.css"
|       rel="stylesheet"
|       type="text/css"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                font: 20px/1 Ahem;
                position: relative;
            }
            #div2
            {
                color: red;
            }
            #div3
            {
                position: absolute;
                top: 0;
            }
            #div4
            {
                position: absolute;
                top: 6em;
                left: 1em;
            }
            #span1
            {
                vertical-align: +6em;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there are 2 small black squares and "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "no red"
|       "."
|     "
        "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="div1"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div2"
|         "
                "
|         <span {http://www.w3.org/1999/xhtml}>
|           id="span1"
|           "X"
|         "X
            "
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div3"
|         "X"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div4"
|         "X"
|       "
        "
|     "
    "
