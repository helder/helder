    "
|   <head {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <title {http://www.w3.org/1999/xhtml}>
|       "CSS Test: Padding-right using percentage with a negative zero value, -0%"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.microsoft.com/"
|       rel="author"
|       title="Microsoft"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.gtalbot.org/BrowserBugsSection/css21testsuite/"
|       rel="reviewer"
|       title="Gérard Talbot"
|     " "
|     <!--  2012-08-25  -->
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/box.html#propdef-padding-right"
|       rel="help"
|     "
        "
|     <link {http://www.w3.org/1999/xhtml}>
|       href="http://www.w3.org/TR/CSS21/box.html#padding-properties"
|       rel="help"
|     "
		"
|     <link {http://www.w3.org/1999/xhtml}>
|       href="padding-right-089-ref.xht"
|       rel="match"
|     "

        "
|     <meta {http://www.w3.org/1999/xhtml}>
|       content="The 'padding-right' property handles a negative zero length value in percentage."
|       name="assert"
|     "
        "
|     <style {http://www.w3.org/1999/xhtml}>
|       type="text/css"
|       "
            div
            {
                height: 1in;
            }
            #wrapper
            {
                width: 1in;
            }
            #div1
            {
                border-right: 5px solid blue;
                padding-right: -0%;
            }
            #div2
            {
                border-right: 5px solid orange;
            }
        "
|     "
    "
|   "
    "
|   <body {http://www.w3.org/1999/xhtml}>
|     "
        "
|     <p {http://www.w3.org/1999/xhtml}>
|       "Test passes if there is "
|       <strong {http://www.w3.org/1999/xhtml}>
|         "no space between"
|       " the blue and orange lines."
|     "
       "
|     <div {http://www.w3.org/1999/xhtml}>
|       id="wrapper"
|       "
            "
|       <div {http://www.w3.org/1999/xhtml}>
|         id="div1"
|         "
                "
|         <div {http://www.w3.org/1999/xhtml}>
|           id="div2"
|         "
            "
|       "
        "
|     "
    "
