{
  "name": "helder",
  "version": "0.1.0",
  "description": "An experimental app and GUI stack in Haxe",
  "license": "MIT",
  "homepage": "https://helder.build",
  "files": [
    "src/",
    "apps/studio/src/",
    "apps/studio/fonts/",
    "apps/studio/web/",
    "apps/studio/package.json",
    "!**/*.test.hx",
    "!**/*.test.ts",
    "!**/*.snap"
  ],
  "bin": {
    "helder": "src/helder/cli/run.mjs"
  },
  "exports": {
    "./view": {
      "types": "./src/helder/view/index.d.ts"
    },
    "./ui": {
      "types": "./src/helder/ui/index.d.ts"
    },
    "./ui/actions": {
      "types": "./src/helder/ui/actions/index.ts"
    },
    "./web": {
      "types": "./src/helder/web/index.d.ts"
    },
    "./canvas": {
      "types": "./src/helder/canvas/index.d.ts"
    },
    "./async": {
      "types": "./src/helder/async/index.d.ts"
    },
    "./os": {
      "types": "./src/helder/os/index.d.ts"
    },
    "./store": {
      "types": "./src/helder/store/index.d.ts"
    },
    "./media": {
      "types": "./src/helder/media/index.d.ts"
    },
    "./markdown": {
      "types": "./src/helder/markdown/index.d.ts"
    },
    "./gfx": {
      "types": "./src/helder/gfx/index.ts"
    },
    "./dev": {
      "types": "./src/helder/dev/index.d.ts"
    },
    "./asset": {
      "types": "./src/helder/asset/index.d.ts"
    },
    "./jobs": {
      "types": "./src/helder/jobs/index.d.ts"
    },
    "./story": {
      "types": "./src/helder/story/index.d.ts"
    },
    "./scene": {
      "types": "./src/helder/scene/index.ts"
    },
    "./native": {
      "types": "./src/helder/native/index.ts"
    },
    "./platform": {
      "types": "./src/helder/platform/index.ts"
    },
    "./test": {
      "types": "./src/helder/test/index.ts"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "haxe": {
    "name": "helder",
    "classPath": "src"
  },
  "scripts": {
    "test": "haxe -cp tests --run Run",
    "helder": "node src/helder/cli/run.mjs",
    "site": "node site/build.mjs",
    "site:check": "node site/check.mjs",
    "site:numbers": "node site/numbers.mjs",
    "site:reel": "node site/reel.mjs",
    "site:visuals": "node site/visuals.mjs"
  },
  "dependencies": {
    "@hx-objc/apple-uikit": "github:hx-objc/apple-uikit#27.2.0",
    "@hxmc/cli": "0.1.0-nightly.20261123.717d9f7"
  },
  "peerDependencies": {
    "typescript": ">=7.1.0-0"
  },
  "devDependencies": {
    "@hxmc/source": "0.1.0-nightly.20261123.717d9f7",
    "@typescript/typescript-wasip1-wasm": "7.1.0-dev.20261106.1",
    "typescript": "7.1.0-dev.20261106.1"
  },
  "trustedDependencies": [
    "@hxmc/cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helder/helder.git"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
